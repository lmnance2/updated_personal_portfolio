# Guestbook admin (DELETE /api/guestbook/admin?id=...)
GUESTBOOK_ADMIN_TOKEN=

# Vercel KV (required for the guestbook).
# Create a KV store on Vercel, link the project, then pull these in via
# `vercel env pull .env.local` or paste them by hand.
KV_REST_API_READ_ONLY_TOKEN=
KV_REST_API_TOKEN=
KV_REST_API_URL=
KV_URL=
REDIS_URL=
